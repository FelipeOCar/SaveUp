<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SaveUp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SaveUp.Models"
    xmlns:vm="clr-namespace:SaveUp.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    Title="Dashboard">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,22,24,18" BackgroundColor="{StaticResource Primary}">
            <Label
                Text="SaveUp"
                TextColor="White"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24"
                Spacing="18"
                MaximumWidthRequest="720"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Guten Tag" Style="{StaticResource CaptionLabelStyle}" />
                    <Label
                        Text="Dein Sparfortschritt"
                        Style="{StaticResource PageTitleStyle}"
                        SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasOperationError}"
                    Style="{StaticResource DangerCardStyle}">
                    <Label Text="{Binding OperationError}" TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Border Style="{StaticResource PrimaryCardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gesamteinsparung" TextColor="White" FontSize="14" />
                        <Label
                            Text="{Binding TotalSavings, StringFormat='CHF {0:F2}'}"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            FontSize="32" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Diese Woche" Style="{StaticResource CaptionLabelStyle}" />
                            <Label
                                Text="{Binding WeeklySavings, StringFormat='CHF {0:F2}'}"
                                Style="{StaticResource StatValueStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Verzichte" Style="{StaticResource CaptionLabelStyle}" />
                            <Label
                                Text="{Binding EntryCount, StringFormat='{0} Einträge'}"
                                Style="{StaticResource StatValueStyle}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Letzte 7 Tage" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,0" />

                <Border Style="{StaticResource CardStyle}" Padding="12,16">
                    <Grid RowDefinitions="Auto,150" RowSpacing="10">
                        <Label Text="CHF pro Tag" Style="{StaticResource CaptionLabelStyle}" />

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding LastSevenDays}"
                            SelectionMode="None"
                            HorizontalOptions="Center">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DailySavingBar">
                                    <Grid
                                        WidthRequest="42"
                                        RowDefinitions="24,100,22"
                                        RowSpacing="2">
                                        <Label
                                            Text="{Binding Amount, StringFormat='{0:F0}'}"
                                            FontSize="9"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="End"
                                            LineBreakMode="TailTruncation" />
                                        <Grid Grid.Row="1" HeightRequest="100">
                                            <BoxView
                                                HeightRequest="{Binding BarHeight}"
                                                VerticalOptions="End"
                                                Style="{StaticResource ChartBarStyle}" />
                                        </Grid>
                                        <Label
                                            Grid.Row="2"
                                            Text="{Binding DayLabel}"
                                            Style="{StaticResource ChartLabelStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <Button
                    Text="Neuen Verzicht erfassen"
                    Command="{Binding NewEntryCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    SemanticProperties.Hint="Öffnet das Formular für einen neuen Verzicht" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
