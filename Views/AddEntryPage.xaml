<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SaveUp.Views.AddEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SaveUp.ViewModels"
    x:DataType="vm:AddEntryViewModel"
    Shell.NavBarIsVisible="False"
    Title="Erfassen">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,22,24,18" BackgroundColor="{StaticResource Primary}">
            <Label
                Text="Verzicht erfassen"
                TextColor="White"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24"
                Spacing="18"
                MaximumWidthRequest="720"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="7">
                    <Label Text="Kurzbeschreibung" Style="{StaticResource FieldLabelStyle}" />
                    <Entry
                        Text="{Binding Description}"
                        Placeholder="z. B. Kaffee unterwegs"
                        ReturnType="Next"
                        MaxLength="80"
                        SemanticProperties.Description="Kurzbeschreibung des Kaufverzichts" />
                    <Label
                        Text="{Binding DescriptionError}"
                        IsVisible="{Binding HasDescriptionError}"
                        Style="{StaticResource ErrorLabelStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Gesparter Betrag" Style="{StaticResource FieldLabelStyle}" />
                    <Entry
                        Text="{Binding AmountText}"
                        Placeholder="CHF 0.00"
                        Keyboard="Numeric"
                        ReturnType="Done"
                        SemanticProperties.Description="Gesparter Betrag in Schweizer Franken" />
                    <Label
                        Text="{Binding AmountError}"
                        IsVisible="{Binding HasAmountError}"
                        Style="{StaticResource ErrorLabelStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Datum" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Date="{Binding Date}" Format="dd.MM.yyyy" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Uhrzeit" Style="{StaticResource FieldLabelStyle}" />
                    <TimePicker Time="{Binding Time}" Format="HH:mm" />
                </VerticalStackLayout>

                <Border Style="{StaticResource InfoCardStyle}">
                    <Label
                        Text="Datum und Uhrzeit sind mit dem aktuellen Zeitpunkt vorbelegt."
                        TextColor="{StaticResource Primary}"
                        FontSize="13" />
                </Border>

                <Border
                    IsVisible="{Binding HasOperationError}"
                    Style="{StaticResource DangerCardStyle}">
                    <Label Text="{Binding OperationError}" TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Button
                    Text="Speichern"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Text="Eingaben zurücksetzen"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
