<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#2E7D32</Color>
    <Color x:Key="PrimaryDark">#1B5E20</Color>
    <Color x:Key="PrimaryLight">#E8F5E9</Color>
    <Color x:Key="PrimaryLightDark">#19351D</Color>

    <Color x:Key="PageBackground">#F5F7F5</Color>
    <Color x:Key="PageBackgroundDark">#101410</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1B211D</Color>

    <Color x:Key="TextPrimary">#1D211E</Color>
    <Color x:Key="TextPrimaryDark">#F4F7F4</Color>
    <Color x:Key="TextMuted">#667068</Color>
    <Color x:Key="TextMutedDark">#ADB7AF</Color>

    <Color x:Key="Border">#DDE3DE</Color>
    <Color x:Key="BorderDark">#354138</Color>
    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="DangerLight">#FCE8E6</Color>
    <Color x:Key="DangerLightDark">#45211F</Color>
    <Color x:Key="Disabled">#AEB6B0</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Transparent">Transparent</Color>
</ResourceDictionary>
